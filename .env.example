# Backend settings for STYLEAI. Copy this file to `.env` (git-ignored) and fill in what you need.
# Every value is optional: with none of them set, the app runs on the committed product catalogue
# and photo try-on reports that it is not configured. Real environment variables override .env.
# Never commit .env or put real keys in this example file.

# --- Product catalogue -------------------------------------------------------------------------
# Scrape the brand stores from this machine in the background (default: false). Leave it off on shared
# home/college networks: Shopify rate-limits per IP and then blocks product pages for everyone on it.
# The shared catalogue is refreshed daily by .github/workflows/refresh-catalog.yml.
STYLEAI_CATALOG_AUTO_REFRESH=false
# `static` = use only the original 50-item sample CSV (tests use this).
STYLEAI_CATALOG_SOURCE=live
STYLEAI_CATALOG_TTL_HOURS=12
STYLEAI_CATALOG_RETRY_MINUTES=45
STYLEAI_RATE_LIMIT_PAUSE_MINUTES=20
# Comma-separated brand keys from live_catalog/brands.py to scrape (empty = all).
STYLEAI_CATALOG_BRANDS=

# --- Virtual try-on ------------------------------------------------------------------------------
# Provider chain, first available wins: worker (open-source CatVTON on your own hardware, see
# tools/tryon-worker), gradio / huggingface (IDM-VTON Space, small free quota), fashn (paid), none.
STYLEAI_TRYON_PROVIDER=worker,huggingface
STYLEAI_TRYON_WORKER_URL=http://127.0.0.1:8100
STYLEAI_TRYON_SPACE=yisol/IDM-VTON
STYLEAI_TRYON_TIMEOUT=420
# A free Hugging Face account token raises the shared GPU quota of the hosted Space.
HF_TOKEN=
# Paid FASHN API (only used with STYLEAI_TRYON_PROVIDER=fashn).
FASHN_API_KEY=
FASHN_API_URL=https://api.fashn.ai/v1

# --- Shopping providers (affiliate APIs; need approved accounts) --------------------------------
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in
FLIPKART_AFFILIATE_ID=
USE_MOCK_SHOPPING_DATA=false

# --- Server --------------------------------------------------------------------------------------
STYLEAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For cross-site frontend/API deployments, use SameSite=None with HTTPS and Secure cookies.
STYLEAI_COOKIE_SAMESITE=lax
STYLEAI_COOKIE_SECURE=false
