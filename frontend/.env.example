# Frontend (Vite) settings — copy to .env.local if you need to change them.
# Only VITE_* variables are exposed to the browser. Never put secrets here.

# Base URL of the FastAPI backend. Leave empty in development: Vite proxies /api to STYLEAI_BACKEND_URL.
VITE_API_BASE_URL=

# Where the Vite dev/preview server proxies /api (not exposed to the browser).
STYLEAI_BACKEND_URL=http://127.0.0.1:8000
